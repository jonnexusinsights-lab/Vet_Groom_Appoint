# Environment configuration template

# 1. Database Connection (PostgreSQL & Prisma)
# Replace placeholders with actual credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vet_groom_appoint?schema=public"

# 2. Next.js and Authentication (NextAuth / Auth.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret key locally: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# 3. Cognitive / LLM Integrations
LLM_PROVIDER="gemini" # gemini, openai, anthropic
# Local developer API keys (Gitignored)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 4. Storage & Media (S3 Compatible Storage)
S3_ENDPOINT="http://localhost:9000" # MinIO for local dev, AWS S3 endpoint for prod
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="fashion-pets-uploads"
S3_REGION="us-east-1"
